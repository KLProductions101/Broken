-- Toggle Dropdown
local isDropdownOpen = false
selectTargetBtn.MouseButton1Click:Connect(function()
	isDropdownOpen = not isDropdownOpen
	if isDropdownOpen then
		dropdownFrame.Visible = true
		dropdownFrame:TweenSize(UDim2.new(0, 230, 0, 100), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
		avatarInput:TweenPosition(UDim2.new(0, 15, 0, 182), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
		morphButton:TweenPosition(UDim2.new(0, 15, 0, 222), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
		mainFrame:TweenSize(UDim2.new(0, 260, 0, 270), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
		
		for _, child in ipairs(dropdownFrame:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		
		for _, p in ipairs(Players:GetPlayers()) do
			local pBtn = Instance.new("TextButton")
			pBtn.Size = UDim2.new(1, 0, 0, 28)
			pBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
			pBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
			pBtn.Text = "  " .. p.Name
			pBtn.TextXAlignment = Enum.TextXAlignment.Left
			pBtn.Font = Enum.Font.Gotham
			pBtn.TextSize = 13
			pBtn.Parent = dropdownFrame
			
			pBtn.MouseButton1Click:Connect(function()
				selectedTargetPlayer = p
				selectTargetBtn.Text = "Target: " .. p.Name
				isDropdownOpen = false
				dropdownFrame:TweenSize(UDim2.new(0, 230, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
				task.wait(0.2)
				dropdownFrame.Visible = false
				avatarInput:TweenPosition(UDim2.new(0, 15, 0, 80), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
				morphButton:TweenPosition(UDim2.new(0, 15, 0, 125), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
				mainFrame:TweenSize(UDim2.new(0, 260, 0, 195), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
			end)
		end
	else
		isDropdownOpen = false
		dropdownFrame:TweenSize(UDim2.new(0, 230, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
		task.wait(0.2)
		dropdownFrame.Visible = false
		avatarInput:TweenPosition(UDim2.new(0, 15, 0, 80), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
		morphButton:TweenPosition(UDim2.new(0, 15, 0, 125), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
		mainFrame:TweenSize(UDim2.new(0, 260, 0, 195), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
	end
end)

-- RGB Effect
local hue = 0
RunService.RenderStepped:Connect(function(dt)
	if mainFrame and mainFrame.Parent then
		hue = (hue + (dt * 0.15)) % 1
		morphButton.BackgroundColor3 = Color3.fromHSV(hue, 0.7, 0.8)
	end
end)

-- Client Morph Execution
morphButton.MouseButton1Click:Connect(function()
	local avatarStr = avatarInput.Text
	if avatarStr == "" then return end
	
	local targetChar = selectedTargetPlayer and selectedTargetPlayer.Character
	local humanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
	if not targetChar or not humanoid then return end
	
	local targetUserId = tonumber(avatarStr)
	if not targetUserId then
		local success, res = pcall(function()
			return Players:GetUserIdFromNameAsync(avatarStr)
		end)
		if success then targetUserId = res else return end
	end
	
	-- Detect Rig Type (R6 or R15)
	local currentRigType = humanoid.RigType
	
	local modelSuccess, generatedModel = pcall(function()
		local desc = Players:GetHumanoidDescriptionFromUserId(targetUserId)
		return Players:CreateHumanoidModelFromDescription(desc, currentRigType)
	end)
	
	if modelSuccess and generatedModel then
		-- Clear target character clothes, body accessories, colors, meshes
		for _, item in ipairs(targetChar:GetChildren()) do
			if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
				item:Destroy()
			end
		end
		
		-- Match part colors
		for _, targetItem in ipairs(generatedModel:GetChildren()) do
			local existingPart = targetChar:FindFirstChild(targetItem.Name)
			if existingPart and existingPart:IsA("BasePart") and existingPart.Name ~= "HumanoidRootPart" then
				existingPart.Color = targetItem.Color
			end
		end
		
		-- Copy Face & Head Mesh
		local targetHead = generatedModel:FindFirstChild("Head")
		local currentHead = targetChar:FindFirstChild("Head")
		if targetHead and currentHead then
			for _, child in ipairs(currentHead:GetChildren()) do
				if child:IsA("Decal") or child:IsA("SpecialMesh") then
					child:Destroy()
				end
			end
			
			local newFace = targetHead:FindFirstChildOfClass("Decal")
			if newFace then
				newFace:Clone().Parent = currentHead
			end
			
			local newMesh = targetHead:FindFirstChildOfClass("SpecialMesh")
			if newMesh then
				newMesh:Clone().Parent = currentHead
			end
		end
		
		-- Apply Clothes
		for _, item in ipairs(generatedModel:GetChildren()) do
			if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
				item:Clone().Parent = targetChar
			elseif item:IsA("Accessory") then
				local clonedAccessory = item:Clone()
				local handle = clonedAccessory:FindFirstChild("Handle")
				if handle then
					-- Attach accessory using native Humanoid attachment logic
					local attachment = handle:FindFirstChildOfClass("Attachment")
					if attachment then
						local targetAttachment = targetChar:FindFirstChild(attachment.Name, true)
						if targetAttachment then
							handle.CFrame = targetAttachment.WorldCFrame * attachment.CFrame:Inverse()
							local weld = Instance.new("WeldConstraint")
							weld.Part0 = handle
							weld.Part1 = targetAttachment.Parent
							weld.Parent = handle
						end
					end
				end
				clonedAccessory.Parent = targetChar
			end
		end
		
		generatedModel:Destroy()
	end
end)
