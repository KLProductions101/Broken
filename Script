local function showNotice(text, isSuccess)
	successLabel.Text = text
	successLabel.TextColor3 = isSuccess and Color3.fromRGB(100, 255, 150) or Color3.fromRGB(255, 80, 80)
	successLabel.TextTransparency = 0
	task.wait(0.6)
	TweenService:Create(successLabel, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
end

-- Helper to fetch UserId safely from username or ID string
local function getUserId(inputStr)
	local num = tonumber(inputStr)
	if num then return num end
	
	local success, result = pcall(function()
		return Players:GetUserIdFromNameAsync(inputStr)
	end)
	if success then
		return result
	end
	return nil
end

-- Client-Side Morph Functionality (Supports Target Player + Target Avatar)
morphButton.MouseButton1Click:Connect(function()
	local targetStr = targetInput.Text
	local avatarStr = avatarInput.Text
	
	if avatarStr == "" then
		showNotice("Missing Avatar", false)
		return
	end
	
	-- Determine target character
	local targetChar = nil
	if targetStr == "" then
		targetChar = localPlayer.Character
	else
		-- Check if target is a player name or UserId
		local foundPlayer = Players:FindFirstChild(targetStr)
		if not foundPlayer then
			local targetIdNum = tonumber(targetStr)
			if targetIdNum then
				for _, p in ipairs(Players:GetPlayers()) do
					if p.UserId == targetIdNum then
						foundPlayer = p
						break
					end
				end
			end
		end
		
		if foundPlayer then
			targetChar = foundPlayer.Character
		else
			-- Try workspace model fallback
			targetChar = workspace:FindFirstChild(targetStr)
		end
	end
	
	local humanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
	if not targetChar or not humanoid then
		showNotice("Invalid Target", false)
		return
	end
	
	-- Get Avatar User ID to morph into
	local avatarUserId = getUserId(avatarStr)
	if not avatarUserId then
		showNotice("Invalid Avatar", false)
		return
	end
	
	local modelSuccess, generatedModel = pcall(function()
		local desc = Players:GetHumanoidDescriptionFromUserId(avatarUserId)
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
	end)
	
	if modelSuccess and generatedModel then
		-- Clear old clothes, colors, and accessories on target character locally
		for _, item in ipairs(targetChar:GetChildren()) do
			if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
				item:Destroy()
			end
		end
		
		-- Match limb colors
		for _, targetItem in ipairs(generatedModel:GetChildren()) do
			local existingPart = targetChar:FindFirstChild(targetItem.Name)
			if existingPart and existingPart:IsA("BasePart") and existingPart.Name ~= "HumanoidRootPart" then
				existingPart.Color = targetItem.Color
			end
		end

		-- Head, Mesh, and Face Extraction
		local targetHead = generatedModel:FindFirstChild("Head")
		local currentHead = targetChar:FindFirstChild("Head")
		if targetHead and currentHead then
			local oldFace = currentHead:FindFirstChildOfClass("Decal")
			if oldFace then oldFace:Destroy() end
			
			local newFace = targetHead:FindFirstChildOfClass("Decal")
			if newFace then 
				newFace:Clone().Parent = currentHead 
			else
				local defaultFace = Instance.new("Decal")
				defaultFace.Name = "face"
				defaultFace.Texture = "rbxasset://textures/face.png"
				defaultFace.Parent = currentHead
			end

			local oldMesh = currentHead:FindFirstChildOfClass("SpecialMesh")
			if oldMesh then oldMesh:Destroy() end
			
			local newMesh = targetHead:FindFirstChildOfClass("SpecialMesh")
			if newMesh then 
				newMesh:Clone().Parent = currentHead 
			end
		end
		
		-- Apply classic clothing and accessories
		for _, item in ipairs(generatedModel:GetChildren()) do
			if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
				item:Clone().Parent = targetChar
			elseif item:IsA("Accessory") then
				local clonedAccessory = item:Clone()
				local handle = clonedAccessory:FindFirstChild("Handle")
				if handle then
					local attachment = handle:FindFirstChildOfClass("Attachment")
					if attachment then
						local targetAttachment = targetChar:FindFirstChild(attachment.Name, true)
						if targetAttachment then
							handle.CFrame = targetAttachment.WorldCFrame
							local weld = Instance.new("Weld")
							weld.Name = "AccessoryWeld"
							weld.Part0 = handle
							weld.Part1 = targetAttachment.Parent
							weld.C0 = attachment.CFrame
							weld.C1 = targetAttachment.CFrame
							weld.Parent = handle
						end
					end
				end
				clonedAccessory.Parent = targetChar
			end
		end
		
		generatedModel:Destroy()
		showNotice("Success!", true)
	else
		showNotice("Error", false)
	end
end)
