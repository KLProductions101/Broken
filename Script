spinTween:Play()

--- [[ Progress Timer (1% to 100% over 2 Seconds) ]] ---
local TOTAL_DURATION = 2.0
local STEPS = 100
local STEP_DELAY = TOTAL_DURATION / STEPS

for i = 1, 100 do
	percentLabel.Text = "Loading... " .. tostring(i) .. "%"
	task.wait(STEP_DELAY)
end

spinTween:Cancel()

-- Fade out splash screen
local fadeInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local fadeTween = TweenService:Create(mainLoadingFrame, fadeInfo, { BackgroundTransparency = 1 })

TweenService:Create(splashImage, fadeInfo, { ImageTransparency = 1 }):Play()
TweenService:Create(spinner, fadeInfo, { ImageTransparency = 1 }):Play()
TweenService:Create(percentLabel, fadeInfo, { TextTransparency = 1 }):Play()

fadeTween:Play()
fadeTween.Completed:Wait()

loadingGui:Destroy()
sound:Destroy()

