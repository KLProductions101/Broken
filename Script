-- 2. RGB Effect
local hue = 0
local rgbConnection
rgbConnection = RunService.RenderStepped:Connect(function(dt)
	if not mainFrame or not mainFrame.Parent then
		rgbConnection:Disconnect()
		return
	end
	hue = (hue + (dt * 0.15)) % 1
	morphButton.BackgroundColor3 = Color3.fromHSV(hue, 0.7, 0.8)
end)

local function showNotice(text, isSuccess)
	successLabel.Text = text
	successLabel.TextColor3 = isSuccess and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(255, 75, 75)
	successLabel.TextTransparency = 0
	task.wait(0.5)
	TweenService:Create(successLabel, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
end

-- 3. Fixed Morph Functionality
morphButton.MouseButton1Click:Connect(function()
	local targetInput = inputField.Text
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	
	if not character or not humanoid or targetInput == "" then 
		showNotice("Error", false)
		return 
	end
	
	local targetUserId = tonumber(targetInput)
	
	if not targetUserId then
		local idSuccess, idResult = pcall(function()
			return Players:GetUserIdFromNameAsync(targetInput)
		end)
		if idSuccess then
			targetUserId = idResult
		else
			showNotice("Error", false)
			return
		end
	end
	
	local modelSuccess, generatedModel = pcall(function()
		local desc = Players:GetHumanoidDescriptionFromUserId(targetUserId)
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
	end)
	
	if modelSuccess and generatedModel then
		-- Clear old clothes, colors, and accessories
		for _, item in ipairs(character:GetChildren()) do
			if item:IsA("Accessory") or item:IsA("Clothing") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
				item:Destroy()
			end
		end
		
		-- Match limb colors
		for _, targetItem in ipairs(generatedModel:GetChildren()) do
			local existingPart = character:FindFirstChild(targetItem.Name)
			if existingPart and existingPart:IsA("BasePart") and existingPart.Name ~= "HumanoidRootPart" then
				existingPart.Color = targetItem.Color
			end
		end

		-- FIX: Specific Head, Mesh, and Face Extraction
		local targetHead = generatedModel:FindFirstChild("Head")
		local currentHead = character:FindFirstChild("Head")
		if targetHead and currentHead then
			-- Reset Face Decal
			local oldFace = currentHead:FindFirstChildOfClass("Decal")
			if oldFace then oldFace:Destroy() end
			
			local newFace = targetHead:FindFirstChildOfClass("Decal")
			if newFace then 
				newFace:Clone().Parent = currentHead 
			else
				-- If they have no face, make sure a default face asset isn't lingering
				local defaultFace = Instance.new("Decal")
				defaultFace.Name = "face"
				defaultFace.Texture = "rbxasset://textures/face.png"
				defaultFace.Parent = currentHead
			end

			-- Reset SpecialMesh inside Head (Handles head shapes)
			local oldMesh = currentHead:FindFirstChildOfClass("SpecialMesh")
			if oldMesh then oldMesh:Destroy() end
			
			local newMesh = targetHead:FindFirstChildOfClass("SpecialMesh")
			if newMesh then 
				newMesh:Clone().Parent = currentHead 
			end
		end
		
		-- Apply classic clothing objects
		for _, item in ipairs(generatedModel:GetChildren()) do
			if item:IsA("Clothing") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
				item:Clone().Parent = character
			elseif item:IsA("Accessory") then
				-- FIX: Rebuild manual client-side weld attachment fallback
				local clonedAccessory = item:Clone()
				local handle = clonedAccessory:FindFirstChild("Handle")
				if handle then
					local attachment = handle:FindFirstChildOfClass("Attachment")
					if attachment then
						-- Find matching attachment inside player's character structure
						local targetAttachment = character:FindFirstChild(attachment.Name, true)
						if targetAttachment then
							handle.CFrame = targetAttachment.WorldCFrame
							local weld = Instance.new("Weld")
							weld.Name = "AccessoryWeld"
							weld.Part0 = handle
							weld.Part1 = targetAttachment.Parent
							weld.C0 = attachment.CFrame
							weld.C1 = targetAttachment.CFrame
							weld.Parent = handle
						end
					end
				end
				clonedAccessory.Parent = character
			end
		end
		
		generatedModel:Destroy()
		showNotice("Success", true)
	else
		showNotice("Error", false)
	end
end)
