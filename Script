-- [[ VCK EXECUTOR COMPATIBLE MORPH SCRIPT ]] --

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")

-- Safe GUI container parent (tries CoreGui first, falls back to PlayerGui)
local guiParent = pcall(function() return gethui() end) and gethui() or (CoreGui:FindFirstChild("RobloxGui") or playerGui)

-- Double-Run Protection
if guiParent:FindFirstChild("VCK") then
	guiParent.VCK:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "VCK"
screenGui.ResetOnSpawn = false
screenGui.Parent = guiParent

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 260, 0, 160)
mainFrame.Position = UDim2.new(0.5, -130, 0.4, -80)
mainFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 25)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 10)
uiCorner.Parent = mainFrame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 35)
title.Text = "VCK MORPH SYSTEM"
title.TextColor3 = Color3.fromRGB(220, 220, 230)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.TextSize = 12
title.Parent = mainFrame

local targetInput = Instance.new("TextBox")
targetInput.Size = UDim2.new(0, 230, 0, 35)
targetInput.Position = UDim2.new(0, 15, 0, 40)
targetInput.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
targetInput.TextColor3 = Color3.fromRGB(255, 255, 255)
targetInput.PlaceholderText = "Target Player (Name/ID)"
targetInput.Text = ""
targetInput.Font = Enum.Font.Gotham
targetInput.TextSize = 14
targetInput.Parent = mainFrame

local avatarInput = Instance.new("TextBox")
avatarInput.Size = UDim2.new(0, 230, 0, 35)
avatarInput.Position = UDim2.new(0, 15, 0, 80)
avatarInput.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
avatarInput.TextColor3 = Color3.fromRGB(255, 255, 255)
avatarInput.PlaceholderText = "Avatar Username or ID..."
avatarInput.Text = ""
avatarInput.Font = Enum.Font.Gotham
avatarInput.TextSize = 14
avatarInput.Parent = mainFrame

local morphButton = Instance.new("TextButton")
morphButton.Size = UDim2.new(0, 230, 0, 35)
morphButton.Position = UDim2.new(0, 15, 0, 120)
morphButton.Text = "APPLY MORPH"
morphButton.TextColor3 = Color3.fromRGB(255, 255, 255)
morphButton.Font = Enum.Font.GothamBold
morphButton.TextSize = 14
morphButton.Parent = mainFrame

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 6)
buttonCorner.Parent = morphButton

-- RGB Effect
local hue = 0
RunService.RenderStepped:Connect(function(dt)
	if mainFrame and mainFrame.Parent then
		hue = (hue + (dt * 0.15)) % 1
		morphButton.BackgroundColor3 = Color3.fromHSV(hue, 0.7, 0.8)
	end
end)

morphButton.MouseButton1Click:Connect(function()
	local targetStr = targetInput.Text
	local avatarStr = avatarInput.Text
	
	if avatarStr == "" then return end
	
	local targetChar = nil
	if targetStr == "" then
		targetChar = localPlayer.Character
	else
		local foundPlayer = Players:FindFirstChild(targetStr)
		if foundPlayer then
			targetChar = foundPlayer.Character
		end
	end
	
	local humanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
	if not targetChar or not humanoid then return end
	
	local targetUserId = tonumber(avatarStr)
	if not targetUserId then
		local success, res = pcall(function()
			return Players:GetUserIdFromNameAsync(avatarStr)
		end)
		if success then targetUserId = res else return end
	end
	
	local modelSuccess, generatedModel = pcall(function()
		local desc = Players:GetHumanoidDescriptionFromUserId(targetUserId)
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
	end)
	
	if modelSuccess and generatedModel then
		for _, item in ipairs(targetChar:GetChildren()) do
			if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
				item:Destroy()
			end
		end
		
		for _, targetItem in ipairs(generatedModel:GetChildren()) do
			local existingPart = targetChar:FindFirstChild(targetItem.Name)
			if existingPart and existingPart:IsA("BasePart") and existingPart.Name ~= "HumanoidRootPart" then
				existingPart.Color = targetItem.Color
			end
		end
		
		for _, item in ipairs(generatedModel:GetChildren()) do
			if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
				item:Clone().Parent = targetChar
			elseif item:IsA("Accessory") then
				local cloned = item:Clone()
				local handle = cloned:FindFirstChild("Handle")
				if handle then
					local att = handle:FindFirstChildOfClass("Attachment")
					if att then
						local targetAtt = targetChar:FindFirstChild(att.Name, true)
						if targetAtt then
							handle.CFrame = targetAtt.WorldCFrame
							local weld = Instance.new("Weld")
							weld.Part0 = handle
							weld.Part1 = targetAtt.Parent
							weld.C0 = att.CFrame
							weld.C1 = att.CFrame
							weld.Parent = handle
						end
					end
				end
				cloned.Parent = targetChar
			end
		end
		generatedModel:Destroy()
	end
end)
